{
  "expo": {
    "name": "Task Manager",
    "slug": "task-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskmanagement",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B88F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskmanagement.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B88F5",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.taskmanagement.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#5B88F5",
      "androidMode": "default",
      "androidCollapsedTitle": "Task Manager"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5B88F5",
          "dark": {
            "backgroundColor": "#1a1a2e"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B88F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}